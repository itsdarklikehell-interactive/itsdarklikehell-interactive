# itsdarklikehell Interactive — .env.example
# Copy to .env and fill in your values. Never commit .env.

# --- Veloren agent credentials ---
VELOREN_USERNAME=your_username
VELOREN_PASSWORD=your_password

# --- Dashboard ---
DASHBOARD_API_KEY=your_api_key_here
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# --- Server ---
VELUREN_SERVER_BIN=~/.local/share/airshipper/profiles/default/veloren-server-cli
VELUREN_PORT=14004

# --- Agent ---
VELUREN_AGENT_BIN=./target/release/veloren-agent
VELUREN_AGENT_CHARACTER=hermes

# --- Assets ---
VELOREN_ASSETS=/home/rizzo/.local/share/airshipper/profiles/default/assets